# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- Required in production ---
# Shared secret the Pico units send in the X-Pico-Secret header on announce.
# Must match the value baked into each Pico's config.json.
PICO_ANNOUNCE_SECRET=change-me-to-a-random-string

# --- Data directory ---
# Absolute or relative path on the HOST where persistent data lives.
# Defaults to ./mushpi-data next to this compose file. The directory must be
# writable by UID 1000 (the container's `node` user) — on Raspberry Pi OS
# the default `pi` user is UID 1000.
# MUSHPI_DATA_DIR=/home/pi/mushpi-data

# --- Image tag (optional) ---
# Override the pulled image tag for dev/pre-release builds.
# MUSHPI_IMAGE_TAG=latest

# --- Optional overrides ---
# Hostname/IP used to build absolute image URLs (defaults to http://localhost:3000).
# Set to the Pi's LAN or Tailscale hostname so recipe/batch images load on other
# devices (see DEPLOYMENT.md).
# APP_HOST=http://raspberrypi.local

# Swagger docs — leave DOCS_ENDPOINT unset to disable in production.
# DOCS_ENDPOINT=contract
# DOCS_USERNAME=admin
# DOCS_PASSWORD=change-me
